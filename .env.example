# ⚙️ Backend service URL (Go Fiber app)
BACKEND_URL=http://localhost:8080

# 🌍 Port your FastAPI recommender will run on
RECOMMENDER_PORT=8000

# 🌐 Allowed origins for CORS (comma-separated list)
ALLOWED_ORIGINS=http://localhost:5173

# 🐞 Enable debug mode (True/False)
DEBUG=False

# 🔒 Shared secret to lock /recommend to internal (backend) callers.
# Must match the backend's RECOMMENDER_INTERNAL_TOKEN. Empty = open (dev).
INTERNAL_TOKEN=
